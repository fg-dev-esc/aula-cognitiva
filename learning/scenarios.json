                }
              }
            },
            "paginas": {
              "type": "integer",
              "minimum": 1
            },
            "disponible": {
              "type": "boolean"
            },
            "generos": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "anio": {
