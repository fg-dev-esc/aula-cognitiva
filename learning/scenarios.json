        {
          "id": "biblioteca-disponibilidad",
          "description": "disponible es un booleano y no se deduce de la cantidad histórica de prestamos."
        },
        {
          "id": "biblioteca-generos-exactos",
          "description": "Los géneros están en minúsculas; includes compara el valor completo y distingue mayúsculas."
        },
        {
          "id": "biblioteca-find-ausente",
          "description": "Buscar un id inexistente con find produce undefined."
        },
        {
          "id": "biblioteca-orden",
          "description": "El orden de los registros es fijo y find devuelve la primera coincidencia en ese orden."
        }
