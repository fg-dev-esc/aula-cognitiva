{
  "schemaVersion": 1,
  "routeId": "js-arrays-console-v1",
  "language": "es",
  "datasetConventions": {
    "deterministic": true,
    "recordCountRange": {
      "min": 4,
      "max": 7
    },
    "versioning": "Cada dataset tiene un id estable terminado en -v1 y un campo version entero.",
    "reviewUsage": "Los datasets base se usan en la primera práctica; los datasets revision-1, revision-3 y revision-7 son variantes fijas para esos días de revisión.",
    "money": "Todo importe monetario se guarda como un entero en centavos; nunca como decimal.",
    "mutation": "Los ejercicios consultan los registros sin modificar el dataset original."
  },
  "scenarios": [
    {
      "id": "inventario",
      "version": 1,
      "title": "Inventario de una tienda escolar",
      "description": "Productos con existencias, estado comercial, etiquetas, proveedor y ubicación física.",
      "bindingName": "productos",
      "dataShape": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "nombre",
            "categoria",
            "precioCentavos",
            "stock",
            "activo",
            "etiquetas",
            "proveedor",
            "ubicacion"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "Identificador único con formato P-NNN."
            },
            "nombre": {
              "type": "string"
            },
            "categoria": {
              "type": "string"
            },
            "precioCentavos": {
              "type": "integer",
              "minimum": 0,
              "unit": "centavos"
            },
            "stock": {
              "type": "integer",
              "minimum": 0
            },
            "activo": {
              "type": "boolean"
            },
            "etiquetas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "proveedor": {
              "type": "object",
              "required": [
                "id",
                "nombre",
                "pais"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "nombre": {
                  "type": "string"
                },
                "pais": {
                  "type": "string"
                }
              }
            },
            "ubicacion": {
              "type": "object",
              "required": [
                "pasillo",
                "estante"
              ],
              "properties": {
                "pasillo": {
                  "type": "string"
                },
                "estante": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "rules": [
        {
          "id": "inventario-id-unico",
          "description": "Cada id identifica un solo producto dentro del dataset."
        },
        {
          "id": "inventario-stock-disponible",
          "description": "Un producto tiene existencias cuando stock es mayor que 0; activo no implica que tenga stock."
        },
        {
          "id": "inventario-activo",
          "description": "activo indica si el producto se ofrece comercialmente y es independiente de stock."
        },
        {
          "id": "inventario-etiquetas-exactas",
          "description": "Las etiquetas están normalizadas en minúsculas y se comparan por el texto completo."
        },
        {
          "id": "inventario-precio-centavos",
          "description": "precioCentavos siempre es un entero no negativo expresado en centavos."
        }
      ],
